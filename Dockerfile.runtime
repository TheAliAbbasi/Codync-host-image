# Unofficial runtime image. Built FROM the highest published host tag.
# Claude, Cursor, Codex, and xAI (Grok) are installed here. Other agent CLIs are
# fetched on first start when the entrypoint sees the matching auth env vars
# (see scripts/install-agent-on-demand.sh). Google Antigravity is omitted:
# Codync starts its ACP server, which has no documented non-browser init.
ARG HOST_IMAGE=ghcr.io/thealiabbasi/codync-host:latest
FROM ${HOST_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root
ENV DEBIAN_FRONTEND=noninteractive \
    CI=true \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    GOOSE_DISABLE_KEYRING=1 \
    DOTNET_ROOT=/usr/share/dotnet \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

# Installers must not write into the persisted home. A volume on
# /var/lib/codync-host would hide anything stored there.
ENV HOME=/opt/codync-cli \
    PATH="/opt/codync-cli/.local/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bzip2 \
        ca-certificates \
        curl \
        git \
        dbus \
        dbus-x11 \
        gnome-keyring \
        libsecret-1-0 \
        python3 \
        make \
        g++ \
        libicu74 \
        unzip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/codync-cli /usr/share/dotnet \
    && chown -R codync:codync /var/lib/codync-host /opt/codync-cli

# Node.js and npx — https://github.com/nodesource/distributions
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# uv and uvx — https://docs.astral.sh/uv/getting-started/installation/
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

# .NET SDK, including dnx for NuGet connector packages.
# https://learn.microsoft.com/dotnet/core/install/linux-scripted-manual#scripted-install
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/share/dotnet \
    && ln -sf /usr/share/dotnet/dotnet /usr/local/bin/dotnet \
    && if [ -x /usr/share/dotnet/dnx ]; then \
         ln -sf /usr/share/dotnet/dnx /usr/local/bin/dnx; \
       else \
         printf '%s\n' '#!/bin/sh' 'exec /usr/share/dotnet/dotnet dnx "$@"' > /usr/local/bin/dnx; \
         chmod 0755 /usr/local/bin/dnx; \
       fi \
    && chmod -R a+rX /usr/share/dotnet \
    && rm -f /tmp/dotnet-install.sh

# Docker CLI only. dockerd is not installed.
# OCI connectors need a daemon socket mounted in from outside.
# https://docs.docker.com/engine/install/ubuntu/#install-using-the-repository
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && . /etc/os-release \
    && printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu %s stable\n' \
         "$(dpkg --print-architecture)" "$VERSION_CODENAME" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/* \
    && command -v docker \
    && ! command -v dockerd

# Grok (xAI) — https://x.ai/docs (CLI package @xai-official/grok)
RUN npm install -g @xai-official/grok
# Codex — https://github.com/openai/codex
RUN npm install -g @openai/codex

# Cursor Agent — https://cursor.com/docs/cli/overview
RUN curl -fsSL https://cursor.com/install | bash
# Claude Code — https://docs.anthropic.com/en/docs/claude-code/setup
RUN curl -fsSL https://claude.ai/install.sh | bash

RUN set -eu \
    && chmod -R a+rX /opt/codync-cli /usr/local/bin \
    && for modules in /usr/local/lib/node_modules /usr/lib/node_modules; do \
         if [ -d "$modules" ]; then chmod -R a+rX "$modules"; fi; \
       done \
    && find /opt/codync-cli /usr/local -type d -name bin -exec chmod 0755 {} +

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY scripts/install-agent-on-demand.sh /usr/local/lib/codync/install-agent-on-demand.sh
RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh /usr/local/lib/codync/install-agent-on-demand.sh

ENV HOME=/var/lib/codync-host \
    PATH="/usr/local/bin:/opt/codync-cli/.local/bin:/opt/codync-cli/bin:/usr/share/dotnet:${PATH}"

LABEL org.opencontainers.image.title="codync-host-runtime" \
      org.opencontainers.image.description="Unofficial Codync host runtime with core agent CLIs, lazy agent installs, and connector runtimes" \
      org.opencontainers.image.source="https://github.com/TheAliAbbasi/codync-host-image" \
      org.opencontainers.image.licenses="Apache-2.0"

USER codync
WORKDIR /var/lib/codync-host
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["serve"]
